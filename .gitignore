# =============================================================================

# Operating system: Windows

# =============================================================================

# Windows thumbnail cache files

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Windows dump and folder metadata

*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Windows installer packages and shortcuts

*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# =============================================================================

# Visual Studio Code

# =============================================================================

# Ignore local VS Code state, but retain shareable workspace configuration.

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# VS Code extensions

*.vsix

# Keep workspace files version-controlled when explicitly added.

!*.code-workspace

# =============================================================================

# Python

# =============================================================================

# Byte-compiled, optimized, and extension files

**pycache**/
*.py[codz]
*$py.class
*.so
*.pyd
*.dll
*.dylib

# Distribution and packaging artifacts

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller

*.manifest
*.spec

# Installer logs

pip-log.txt
pip-delete-this-directory.txt

# Unit-test, coverage, and property-test artifacts

htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
.pytest_cache/
cover/

# Jupyter and IPython

.ipynb_checkpoints/
profile_default/
ipython_config.py

# Python environments

.env
.env.*
!.env.example
!.env.template
.envrc

.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python package and dependency-manager state

**pypackages**/
.pdm-python
.pdm-build/
.pixi/*
!.pixi/config.toml

# Static analysis and formatting caches

.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# IDE and development-tool state

.spyderproject
.spyproject
.ropeproject
cython_debug/
tempCodeRunnerFile.py

# Python publishing credentials

.pypirc

# Generated documentation

docs/_build/
site/

# =============================================================================

# MATLAB and Simulink

# =============================================================================

# Autosave and backup files

*.asv
*.m~
*.autosave
*.slx.r*
*.mdl.r*
*.bak

# MATLAB P-code and compiled MEX files

*.p
*.mex*

# Packaged MATLAB apps, toolboxes, and deployment archives

*.mlappinstall
*.mltbx
*.ctf

# Generated MATLAB help-search files

helpsearch*/

# Simulink and MATLAB code-generation artifacts

slprj/
sccprj/
codegen/
*.slxc

# MATLAB Drive marker

.MATLABDriveTag

# =============================================================================

# Project-local configuration and secrets

# =============================================================================

# Do not commit machine-specific configurations or credentials.

configs/local/
configs/*.local.yaml
configs/*.local.yml
configs/*.local.json
configs/*.local.toml

# =============================================================================
# Project data
# =============================================================================
# Ignore all data files under data/.
# Keep .gitkeep files so empty data directories can be tracked by Git.

data/**
!data/**/
!data/**/.gitkeep


# =============================================================================
# Experiment results
# =============================================================================
# Ignore all generated experiment outputs under results/.
# Keep .gitkeep files so the results directory structure can be tracked by Git.

results/**
!results/**/
!results/**/.gitkeep


# =============================================================================
# Raw reference materials
# =============================================================================
# Ignore unprocessed reference materials, such as PDFs, Word documents,
# slides, and other source files.
# Keep only the top-level .gitkeep file to preserve docs/references/.

docs/references/**
!docs/references/
!docs/references/.gitkeep


# =============================================================================
# Python test outputs
# =============================================================================
# Ignore generated Python test output files.
# Keep only the top-level .gitkeep file to preserve the outputs directory.

code/python/tests/outputs/**
!code/python/tests/outputs/
!code/python/tests/outputs/.gitkeep


# =============================================================================
# MATLAB test outputs
# =============================================================================
# Ignore generated MATLAB test output files.
# Keep only the top-level .gitkeep file to preserve the outputs directory.

code/matlab/tests/outputs/**
!code/matlab/tests/outputs/
!code/matlab/tests/outputs/.gitkeep
